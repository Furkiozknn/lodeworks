msgstr "%.1f · güvenli %.1f-%.1f"

#: res://scripts/ui/main.gd
msgid "%.1f · safe to %.1f"
msgstr "%.1f · güvenli sınır %.1f"

#: res://scripts/ui/main.gd
msgid "Core %d"
msgstr "Çekirdek %d"

#: res://scripts/ui/main.gd
msgid "How hard this one machine runs. Cool: three quarters of the speed, half its own heat. Hot: a quarter faster, 60% more heat. A Boiler run Low gives half its heat."
msgstr "Bu makinenin ne kadar zorlandığı. Serin: hızın dörtte üçü, kendi ısısının yarısı. Sıcak: dörtte bir daha hızlı, %60 daha fazla ısı. Kısık çalışan bir Kazan ısısının yarısını verir."

#: res://scripts/ui/main.gd
msgid "What this one machine makes. Deeper rock and the Core's levels open new jobs: crystal from a Drill, alloy from a Smelter at white heat, frames from an Assembler."
msgstr "Bu tek makinenin ne ürettiği. Daha derin kaya ve Çekirdeğin seviyeleri yeni işler açar: Matkaptan kristal, akkor sıcaklıktaki Ergiticiden alaşım, Montajcıdan çerçeve."

#: res://scripts/ui/main.gd
msgid "Low"
msgstr "Kısık"

#: res://scripts/ui/main.gd
msgid "Cool"
msgstr "Serin"

#: res://scripts/ui/main.gd
msgid "Hot"
msgstr "Sıcak"

#: res://scripts/ui/main.gd
