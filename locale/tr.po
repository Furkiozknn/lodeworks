msgstr "İki parmakla sıkıştırmadan oynamak için yakınlaştırma tuşu"

#: res://scripts/ui/main.gd
msgid "Reduce motion"
msgstr "Hareketi azalt"

#: res://scripts/ui/main.gd
msgid "No swelling, flickering or plunging"
msgstr "Şişme, titreme ve dalma efektleri yok"

#: res://scripts/ui/main.gd
msgid "Larger text"
