#: res://scripts/core/monetization_db.gd
msgid "Foreman's Licence"
msgstr "Ustabaşı Ruhsatı"

#: res://scripts/core/monetization_db.gd
msgid "Keep the night shift running."
msgstr "Gece vardiyası çalışmaya devam etsin."

#: res://scripts/core/monetization_db.gd
msgid "No extra credits, no faster machines, nothing locked behind it."
msgstr "Ekstra kredi yok, daha hızlı makine yok, arkasında kilitli hiçbir şey yok."

#: res://scripts/core/monetization_db.gd
msgid "Bank 8 hours offline instead of 4"
msgstr "Çevrimdışıyken 4 yerine 8 saat biriktir"

#: res://scripts/core/monetization_db.gd
msgid "No ads, ever"
msgstr "Hiç reklam yok"

#: res://scripts/core/monetization_db.gd
msgid "Foundry Colours"
msgstr "Döküm Renkleri"

#: res://scripts/core/monetization_db.gd
msgid "Six ways for the shaft to look."
msgstr "Kuyu için altı görünüm."

#: res://scripts/core/monetization_db.gd
msgid "Appearance only. The board earns the same in every palette."
msgstr "Yalnızca görünüm. Tahta her palette aynı kazanır."

#: res://scripts/core/monetization_db.gd
msgid "Six palettes for machines, ore and rock"
msgstr "Makineler, cevher ve kaya için altı palet"

#: res://scripts/core/monetization_db.gd
msgid "Switch whenever you like"
msgstr "İstediğin zaman değiştir"

#: res://scripts/core/monetization_db.gd
msgid "Status lights keep their meaning"
msgstr "Durum ışıkları anlamlarını korur"

#: res://scripts/ui/themes.gd
msgid "Shaft"
msgstr "Kuyu"

#: res://scripts/ui/themes.gd
msgid "Cold rock, and heat the only warm thing in it."
msgstr "Soğuk kaya; içindeki tek sıcak şey ısı."

#: res://scripts/ui/themes.gd
msgid "Brass Works"
msgstr "Pirinç Atölye"

#: res://scripts/ui/themes.gd
msgid "Copper, lacquer and a shaft that never cooled."
msgstr "Bakır, cila ve hiç soğumamış bir kuyu."

#: res://scripts/ui/themes.gd
msgid "Deep Frost"
msgstr "Derin Ayaz"

#: res://scripts/ui/themes.gd
msgid "A plant built into ice that refuses to melt."
msgstr "Erimeyi reddeden buzun içine kurulmuş bir fabrika."

#: res://scripts/ui/themes.gd
msgid "Verdant Seam"
msgstr "Yeşil Damar"

#: res://scripts/ui/themes.gd
msgid "Something grew down here before you did."
msgstr "Burada senden önce bir şeyler büyümüş."

#: res://scripts/ui/themes.gd
msgid "Ember Cut"
msgstr "Kor Yarığı"

#: res://scripts/ui/themes.gd
msgid "Close enough to the magma to be a bad idea."
msgstr "Kötü bir fikir olacak kadar magmaya yakın."

#: res://scripts/ui/themes.gd
msgid "Slate"
msgstr "Arduvaz"

#: res://scripts/ui/themes.gd
msgid "Grey plant, coloured cargo. Shape does the work."
msgstr "Gri fabrika, renkli yük. İşi şekil görür."
