#: res://scripts/ui/main.gd
msgid "Battery saver"
msgstr "Pil tasarrufu"

#: res://scripts/ui/main.gd
msgid "30 frames a second instead of 60"
msgstr "Saniyede 60 yerine 30 kare"

#: res://scripts/ui/main.gd
msgid "Vibration"
msgstr "Titreşim"

#: res://scripts/ui/main.gd
msgid "A small buzz when you build"
