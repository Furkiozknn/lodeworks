msgstr "%.1f fazla soğuk: yavaş çalışıyor."

#: res://scripts/ui/main.gd
msgid "Running at %d%% of its speed for its heat"
msgstr "Isısı yüzünden hızının %%%d kadarında çalışıyor"

#: res://scripts/ui/main.gd
msgid "It runs on heat: the hotter, the faster, up to %.1f. Past that it chokes."
msgstr "Isıyla çalışır: ne kadar sıcaksa o kadar hızlı, %.1f değerine kadar. Ötesinde tıkanır."

#: res://scripts/ui/main.gd
msgid "Where its heat comes from"
msgstr "Isısı nereden geliyor"

#: res://scripts/ui/main.gd
msgid "What changes it"
msgstr "Bunu ne değiştirir"

#: res://scripts/ui/main.gd
msgid "The rock at stratum %d"
msgstr "%d. katmanın kayası"

#: res://scripts/ui/main.gd
