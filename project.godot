; Lodeworks - idle machine-grid builder
; Godot 4.7

config_version=5

[application]

config/name="Lodeworks"
config/description="An idle machine-grid builder. Place machines, feed each other by adjacency, manage heat, descend the strata."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"
boot_splash/show_image=false

[autoload]

Sim="*res://scripts/sim/sim.gd"
Save="*res://scripts/services/save_service.gd"
Analytics="*res://scripts/services/analytics.gd"
Ads="*res://scripts/services/ads.gd"
Store="*res://scripts/services/store.gd"
Juice="*res://scripts/services/juice.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=30
