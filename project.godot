; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lodeworks"
config/description="An idle machine-grid builder. Place machines, feed each other by adjacency, manage heat, descend the strata."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://assets/icons/icon.svg"

[autoload]

Sim="*res://scripts/sim/sim.gd"
Save="*res://scripts/services/save_service.gd"
Analytics="*res://scripts/services/analytics.gd"
Ads="*res://scripts/services/ads.gd"
Store="*res://scripts/services/store.gd"
Juice="*res://scripts/services/juice.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/translations=PackedStringArray("res://locale/tr.po")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
